# Propulse web portal. Copy this file to .env.local (or set the same names on your host).

# Your Supabase project. These two are the same values the desktop app uses; the key is the
# publishable one and is safe to show in a browser.
PROPULSE_SUPABASE_URL=https://ldtlqfwmivuhrisjhzji.supabase.co
PROPULSE_PUBLISHABLE_KEY=sb_publishable_qOhRxz_6_LoTQ-JYuRI99A_fMN72Khx

# A long random text that protects the sign-in cookie. Make your own, at least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Optional until you add resumes on the web or want meaning-based search here.
# These stay on the server and are never sent to the browser.
GEMINI_API_KEY=
GOOGLE_SERVICE_ACCOUNT=
GOOGLE_DRIVE_ID=
BREVO_API_KEY=
